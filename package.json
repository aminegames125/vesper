{
  "name": "vesper",
  "private": true,
  "version": "0.17.0",
  "description": "Vesper: schedule IPTV recordings on a server, from native Android and Android TV apps.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "turbo run dev --filter=@vesper/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && cargo test --workspace",
    "lint": "biome check . && cargo clippy --workspace -- -D warnings",
    "format": "biome check --write . && cargo fmt --all",
    "server": "cargo run -p vesper-server --",
    "server:lite": "cargo run -p vesper-server -- --mode lite",
    "server:full": "cargo run -p vesper-server -- --mode full"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
