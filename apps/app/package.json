{
  "name": "@vesper/app",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "A fast, light IPTV player with a cinema-first interface.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "sidecar": "node ../../scripts/prepare-sidecar.mjs",
    "desktop": "pnpm sidecar && tauri dev",
    "desktop:build": "pnpm sidecar --release && tauri build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@animateicons/react": "^0.13.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16",
    "@vesper/cloud-client": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@tauri-apps/cli": "^2.12.4"
  }
}
