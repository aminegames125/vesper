# Copy to .env (next to docker-compose.yml) and keep it out of version control.

# The administrator created on the first start of a full-mode server. Required.
# Use a long password; you can change it later in the admin panel.
VESPER_ADMIN_USER=admin
VESPER_ADMIN_PASSWORD=

# Which address the port is published on. 0.0.0.0 = your whole network; 127.0.0.1 = only a
# reverse proxy on this machine (recommended for internet use).
VESPER_PUBLISH=0.0.0.0
VESPER_PORT=8484

# true only when a reverse proxy (Caddy, nginx...) in front sets X-Forwarded-For.
VESPER_TRUST_PROXY=false

# Your time zone, for log times.
TZ=UTC
